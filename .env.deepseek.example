# DeepSeek-V4.1-Flash；只需填入自己的金鑰。
OPTIMIZER_MODE=live
HOST=127.0.0.1
PORT=3000
# 本機使用留空；獨立伺服器代理部署時，明確列出主機或主機:連接埠（逗號分隔）。
# 省略埠只允許標準 80/443，不接受網址或萬用字元；Mac App 強制忽略此清單。
ALLOWED_HOSTS=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=true
# 以非思考模式進行日常 Prompt 編輯，減少等待。
# 需要思考模式時可改為 enabled；兩者都是同一個 Flash 模型。
LLM_THINKING_MODE=disabled
# 可選覆核預設關閉；未設定或 false 僅編輯，一般 1 次呼叫，格式重試時最多 2 次。
# 明確改為 true 才以同模型獨立覆核：通常共 2 次，含修訂／重試最多 4 次，增加付費用量與等待。
LLM_QUALITY_REVIEW=false
# 所有編輯、覆核、修訂與格式重試共用此總時間預算。
LLM_TIMEOUT_MS=90000
