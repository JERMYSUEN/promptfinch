# DeepSeek-V4.1-Flash；只需填入自己的金鑰。
OPTIMIZER_MODE=live
HOST=127.0.0.1
PORT=3000
# 本機使用留空；獨立伺服器代理部署時，明確列出主機或主機:連接埠（逗號分隔）。
# 省略埠只允許標準 80/443，不接受網址或萬用字元；Mac App 強制忽略此清單。
ALLOWED_HOSTS=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=true
# 以非思考模式進行日常 Prompt 編輯，減少等待。
# 需要思考模式時可改為 enabled；兩者都是同一個 Flash 模型。
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_MS=90000
