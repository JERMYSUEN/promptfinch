# 沒有金鑰即可使用；不會向外傳送 Prompt。
OPTIMIZER_MODE=mock
HOST=127.0.0.1
PORT=3000

# 啟用真實模型時改為 OPTIMIZER_MODE=live，並填入以下設定。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# 服務商支援 JSON mode 時用 true；不支援時改為 false。
LLM_JSON_MODE=true
# DeepSeek 可設定 enabled / disabled；其他服務商預設留空。
LLM_THINKING_MODE=
LLM_TIMEOUT_MS=45000
