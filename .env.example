# 沒有金鑰即可使用；不會向外傳送 Prompt。
OPTIMIZER_MODE=mock
HOST=127.0.0.1
PORT=3000
# 本機使用留空。反向代理可明確列出對外主機，以逗號分隔，不接受網址或萬用字元。
# 例如 prompts.example.com,proxy.example.com:8443；省略埠只允許標準 80/443。
# HOST=0.0.0.0 不會自動信任任意主機；Mac App 會強制忽略此清單。
ALLOWED_HOSTS=

# 啟用真實模型時改為 OPTIMIZER_MODE=live，並填入以下設定。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# 服務商支援 JSON mode 時用 true；不支援時改為 false。
LLM_JSON_MODE=true
# DeepSeek 可設定 enabled / disabled；其他服務商預設留空。
LLM_THINKING_MODE=
# 可選覆核，預設 false；未設定或 false 僅編輯，一般 1 次呼叫，格式重試時最多 2 次。
# 明確改為 true 才啟用同模型獨立覆核：通常 2 次，修訂／重試合計最多 4 次，增加等待與付費用量。
LLM_QUALITY_REVIEW=false
# 全部編輯、覆核、修訂與格式重試共用的總時間預算，不會每次重新計時。
LLM_TIMEOUT_MS=45000
